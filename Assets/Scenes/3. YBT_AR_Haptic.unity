  audioClipGueltig: {fileID: 8300000, guid: e6827ceea2417314c8f1c8244d429b23, type: 3}
  textMessagesWeiter:
  - "AV-Scene:\n\nDer Ablauf ist bekannt.\nBei Fragen wende dich an den Versuchsleiter!\r\n\r\nWenn
    alles klar ist, dr\xFCcke \u201EWeiter\u201C."
  - 'Bewegungsrichtung anterior (nach vorne):

    - Standbein = links

    - Spielbein
    = rechts'
  - 'Bewegungsrichtung anterior (nach vorne):

    - Standbein = rechts

    - Spielbein
    = links'
  - 'Bewegungsrichtung posteromedial (hinten rechts):

    - Standbein = links

    -
    Spielbein = rechts'
  - 'Bewegungsrichtung posteromedial (hinten rechts):

    - Standbein = rechts

    -
    Spielbein = links'
  - 'Bewegungsrichtung posterolateral (hinten links):

    - Standbein = links

    -
    Spielbein = rechts'
  - 'Bewegungsrichtung posterolateral (hinten links):

    - Standbein = rechts

    -
